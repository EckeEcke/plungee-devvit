{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "outDir": "../dist/types/server",
    "tsBuildInfoFile": "../dist/types/server/tsconfig.tsbuildinfo",
    "customConditions": [],
    "types": [
      "node",
      "vite/client"
    ],
    "exactOptionalPropertyTypes": false,
    "rootDir": "../src",
    "noUncheckedIndexedAccess": false
  },
  "include": [
    "../src/server/**/*",
    "../src/client/plungee/levels/**/*",
    "../src/client/plungee/sim/**/*",
    "../src/client/plungee/editor/hash.ts",
    "../src/client/plungee/levels/par.json"
  ],
  "exclude": [],
  "references": [
    {
      "path": "./tsconfig.shared.json"
    }
  ]
}
