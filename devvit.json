{
  "$schema": "https://developers.reddit.com/schema/config-file.v1.json",
  "name": "plungee-game",
  "post": {
    "dir": "dist/client",
    "entrypoints": {
      "default": {
        "entry": "splash.html"
      },
      "game": {
        "entry": "game.html"
      },
      "replays": {
        "entry": "replays.html"
      }
    }
  },
  "server": {
    "dir": "dist/server",
    "entry": "index.cjs"
  },
  "menu": {
    "items": [
      {
        "label": "Create a Plungee test post",
        "description": "Playable campaign level",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/post-create"
      },
      {
        "label": "Create current Weekly Challenge",
        "description": "Create this week's deterministic challenge post",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/weekly-create"
      }
    ]
  },
  "triggers": {
    "onAppInstall": "/internal/triggers/on-app-install"
  },
  "scheduler": {
    "tasks": {
      "community-index": {
        "endpoint": "/internal/scheduler/community-index",
        "cron": "*/5 * * * *"
      },
      "weekly-challenge": {
        "endpoint": "/internal/scheduler/weekly",
        "cron": "0 0 * * 1"
      }
    }
  },
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build"
  },
  "permissions": {
    "reddit": {
      "asUser": [
        "SUBMIT_POST",
        "SUBMIT_COMMENT"
      ]
    }
  },
  "dev": {
    "subreddit": "plungee_game_dev"
  }
}
