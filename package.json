
{
  "private": true,
  "name": "plungee-devvit",
  "version": "0.0.0",
  "license": "BSD-3-Clause",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "deploy": "npm run test:types && npm run lint && devvit upload",
    "dev": "devvit playtest",
    "launch": "npm run deploy && devvit publish",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "login": "devvit login",
    "prettier": "prettier --write .",
    "test:types": "tsc --build && vue-tsc --noEmit -p tools/tsconfig.client.json",
    "test:unit": "node --experimental-strip-types --no-warnings=ExperimentalWarning --test \"src/**/*.test.ts\" \"tools/*.test.mjs\""
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "@devvit/start": "0.15.1",
    "@devvit/web": "0.15.1",
    "@hono/node-server": "2.1.3",
    "devvit": "0.15.1",
    "hono": "4.13.13",
    "vue": "^3.5.44"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "^24.13.3",
    "eslint": "10.14.0",
    "globals": "17.13.0",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.3",
    "@vitejs/plugin-vue": "^6.0.10",
    "vue-tsc": "^3.3.13"
  }
}
